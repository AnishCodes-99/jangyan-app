rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.email == 'admin@jangyan.gov.in' ||
         request.auth.token.email == 'admin@jangyan.in');
    }

    // Citizen handbook PDFs: readable by app users, restricted write
    match /handbooks/{category}/{pdfFile} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Profile photos: each citizen can upload their own avatar
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
